# Required — https://github.com/settings/tokens
GITHUB_TOKEN=ghp_xxxxxxxx
# Your GitHub login (from https://github.com/<you>)
GITHUB_USERNAME=your-github-login

# Optional — org slug from github.com/<org>/…
# GITHUB_ORG=your-org

# Optional — Linear → Settings → Account → Security & access → Personal API keys
# https://linear.app/settings/account/security
# LINEAR_API_KEY=lin_api_xxxxxxxx
# LINEAR_TEAM=ENG
# LINEAR_WORKSPACE=your-workspace   # from linear.app/<workspace>/issue/…

# AI provider for summaries, daily standup, usage and conversation chips.
# claude (default): Claude Agent SDK + local Claude Code sessions (~/.claude/projects)
# cursor: Cursor SDK + Cursor billing API + Cursor conversation DB
# AI_PROVIDER=claude
# AI_MODEL=claude-opus-5-5          # default per provider (cursor: claude-opus-4-6)

# Optional — Claude uses your Claude Code login when unset
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxx

# Required only for AI_PROVIDER=cursor — Cursor → Dashboard → Integrations
# https://cursor.com/dashboard/integrations
# CURSOR_API_KEY=key_xxxxxxxx

# Optional — Slack → profile → ⋯ → Copy member ID (e.g. U08ABCDEF)
# SLACK_USER_ID=
# Optional — Slack app User OAuth Token with search:read (xoxp-…).
# Set: the server fetches your messages directly (cheaper, no MCP).
# Unset: the agent searches Slack through its MCP tools.
# SLACK_USER_TOKEN=xoxp-xxxxxxxx

# Deploy status for merged PRs — read from the GitOps repo via GITHUB_TOKEN
# DEPLOY_REPO=gladiaio/kube-gladia
# DEPLOY_IMAGE_MAP=my-repo:gladia-my-image   # default image is gladia-<repo>
# Optional — also check running pods with kubectl (read-only, uses KUBECONFIG;
# Teleport clusters need a valid `tsh login`)
# DEPLOY_LIVE_CHECK=1
# DEPLOY_KUBE_CONTEXTS=prod-EU:K0S,prod-US-gladia-us-12:gladia-us-12
