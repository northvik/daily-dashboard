# Required — https://github.com/settings/tokens
GITHUB_TOKEN=ghp_xxxxxxxx
# Your GitHub login (from https://github.com/<you>)
GITHUB_USERNAME=your-github-login

# Optional — org slug from github.com/<org>/…
# GITHUB_ORG=your-org

# Optional — Linear → Settings → Account → Security & access → Personal API keys
# https://linear.app/settings/account/security
# LINEAR_API_KEY=lin_api_xxxxxxxx
# LINEAR_TEAM=ENG
# LINEAR_WORKSPACE=your-workspace   # from linear.app/<workspace>/issue/…

# Optional — Cursor → Dashboard → Integrations
# https://cursor.com/dashboard/integrations
# CURSOR_API_KEY=key_xxxxxxxx

# Optional — Slack → profile → ⋯ → Copy member ID (e.g. U08ABCDEF)
# Sign into Slack MCP in Cursor; no Slack app install needed
# SLACK_USER_ID=
